# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/

# Training runs / outputs
# Default: ignore everything under runs/ ...
runs/*
# ... EXCEPT the lightweight result JSONs and figures we want to publish.
!runs/.gitkeep
!runs/sota_survey.md
!runs/**/best.json
!runs/**/results.json
!runs/**/tuner.log
!runs/figs/
!runs/figs/**/*.png
!runs/figs/**/*.pdf

# Always skip heavy artifacts
checkpoints/
*.pt
*.pth
*.npz
*.npy

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
